{
  "name": "olarion",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --import tsx server/index.ts",
    "server:watch": "node --import tsx --watch server/index.ts",
    "dev:full": "concurrently \"vite\" \"npm run server:watch\"",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval:rules": "tsx evals/run.ts",
    "eval:check": "tsx evals/run.ts --check",
    "eval:live": "tsx evals/run.ts --live",
    "test:runtime": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.487.0",
    "motion": "^12.23.24",
    "openai": "^6.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
